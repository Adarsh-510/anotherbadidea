[sub_resource type="GDScript" id="GDScript_ym6ig"]
script/source = "extends Node2D

@onready var in_transition: Sprite2D = $In_transition

func _ready() -> void:
	var tween = create_tween()
	tween.tween_property(in_transition, \"modulate:a\", 0, 4)
"

